--==================================================*

-- FIND PICKUP PROMPT*

--==================================================*

local function FindPickup(Egg)

    if not Egg then

        return nil

    end

    for _, Descendant in ipairs(

        Egg:GetDescendants()

    ) do

        if Descendant:IsA("ProximityPrompt") then

            if Descendant.Name == "Pickup" then

                return Descendant

            end

        end

    end

    return nil

end

--==================================================*

-- CANCEL CURRENT TWEEN*

--==================================================*

local function CancelCurrentTween()

    if CurrentTween then

        pcall(function()

            CurrentTween:Cancel()

        end)

        CurrentTween = nil

    end

end

--==================================================*

-- TWEEN TO EGG*

--==================================================*

local function TweenToEgg(Egg)

    local Character = GetCharacter()

    if not Character then

        return false

    end

    local HRP =

        Character:FindFirstChild(

            "HumanoidRootPart"

        )

    if not HRP then

        return false

    end

    local EggPart =

        GetEggPart(Egg)

    if not EggPart then

        return false

    end

    CancelCurrentTween()

    local TargetCFrame =

        EggPart.CFrame

        * CFrame.new(0, 2.5, 0)

    local Distance =

        (HRP.Position - TargetCFrame.Position).Magnitude

    local Duration =

        Distance / math.max(

            TweenSpeed,

            1

        )

    -- Already close enough*

    if Distance <= 1 then

        HRP.CFrame = TargetCFrame

        return true

    end

    -- Smooth straight tween*

    CurrentTween =

        TweenService:Create(

            HRP,

            TweenInfo.new(

                Duration,

                Enum.EasingStyle.Linear,

                Enum.EasingDirection.Out

            ),

            {

                CFrame = TargetCFrame

            }

        )

    local Finished = false

    local Connection

    Connection =

        CurrentTween.Completed:Connect(

            function()

                Finished = true

                if Connection then

                    Connection:Disconnect()

                end

            end

        )

    CurrentTween:Play()

    while not Finished do

        if not AutoPickup then

            CancelCurrentTween()

            return false

        end

        -- Stop if egg disappears*

        if not Egg or not Egg.Parent then

            CancelCurrentTween()

            return false

        end

        task.wait()

    end

    CurrentTween = nil

    return true

end

--==================================================*

-- PICKUP EGG*

--==================================================*

local function PickupEgg(Egg)

    local Prompt =

        FindPickup(Egg)

    if not Prompt then

        return false

    end

    -- Executor proximity prompt function*

    if typeof(fireproximityprompt)

        == "function" then

        local Success =

            pcall(function()

                fireproximityprompt(

                    Prompt

                )

            end)

        if Success then

            return true

        end

    end

    -- Normal prompt fallback*

    local Success =

        pcall(function()

            Prompt:InputHoldBegin()

            task.wait(

                math.max(

                    Prompt.HoldDuration,

                    0.05

                )

            )

            Prompt:InputHoldEnd()

        end)

    return Success

end

--==================================================*

-- CHECK IF EGG IS BEING HELD*

--==================================================*

local function IsHoldingEgg(Egg)

    local Character =

        GetCharacter()

    if not Character then

        return false

    end

    local EggName =

        Egg and Egg.Name

        or SelectedEgg

    for _, Object in ipairs(

        Character:GetDescendants()

    ) do

        local ObjectName =

            string.lower(

                Object.Name

            )

        if string.find(

            ObjectName,

            "egg",

            1,

            true

        ) then

            return true

        end

        if EggName

            and Object.Name == EggName then

            return true

        end

    end

    -- Egg disappearing can mean pickup*

    -- has already been registered.*

    if Egg

        and not Egg.Parent then

        return true

    end

    return false

end

--==================================================*

-- WAIT FOR PICKUP*

--==================================================*

local function WaitForEggPickup(Egg)

    local StartTime = tick()

    -- Wait up to 1 second for the*

    -- game to register the pickup.*

    while AutoPickup

        and (tick() - StartTime) < 1 do

        if IsHoldingEgg(Egg) then

            return true

        end

        task.wait(0.03)

    end

    -- Fallback for games where the*

    -- carried egg isn't visible.*

    return AutoPickup

end

