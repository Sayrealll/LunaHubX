--==================================================
-- AUTO PICKUP LOOP
--==================================================

task.spawn(function()

	while true do

		if AutoPickup then

			local Egg =
				FindSelectedEgg()

			if Egg then

				local ReachedEgg =
					TweenToEgg(Egg)

				if ReachedEgg then

					task.wait(0.05)

					local PickedUp =
						PickupEgg(Egg)

					if PickedUp then

						local PickupRegistered =
							WaitForEggPickup(
								Egg
							)

						if PickupRegistered then

							TweenToPlot()

							task.wait(0.2)

						else

							task.wait(0.1)
						end

					else

						task.wait(0.1)
					end

				else

					task.wait(0.1)
				end

			else

				task.wait(0.15)
			end

		else

			task.wait(0.2)
		end

		task.wait(0.03)
	end
end)
