-- CHARACTER*

--==================================================*

local function GetCharacter()

    local Character = Player.Character

    if not Character then

        return nil

    end

    local Humanoid =

        Character:FindFirstChildOfClass("Humanoid")

    local HRP =

        Character:FindFirstChild("HumanoidRootPart")

    if not Humanoid or not HRP then

        return nil

    end

    return Character

end

--==================================================*

-- FIND EGG PART*

--==================================================*

local function GetEggPart(Egg)

    if not Egg then

        return nil

    end

    if Egg:IsA("BasePart") then

        return Egg

    end

    if Egg:IsA("Model") then

        if Egg.PrimaryPart then

            return Egg.PrimaryPart

        end

        local Pickup =

            Egg:FindFirstChild("Pickup", true)

        if Pickup

            and Pickup:IsA("ProximityPrompt") then

            local Parent = Pickup.Parent

            if Parent

                and Parent:IsA("BasePart") then

                return Parent

            end

        end

        return Egg:FindFirstChildWhichIsA(

            "BasePart",

            true

        )

    end

    return nil

end

