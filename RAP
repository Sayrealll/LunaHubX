-- FIND PLAYER PLOT*

--==================================================*

local function FindPlotTarget()

    local PossibleContainers = {

        workspace:FindFirstChild(

            "Plots"

        ),

        workspace:FindFirstChild(

            "Plot"

        ),

        workspace:FindFirstChild(

            "PlayerPlots"

        ),

        workspace:FindFirstChild(

            "PlotsFolder"

        )

    }

    -- Search common plot containers*

    for _, Container in ipairs(

        PossibleContainers

    ) do

        if Container then

            -- Player name*

            local PlayerPlot =

                Container:FindFirstChild(

                    Player.Name

                )

            if PlayerPlot then

                local Part =

                    PlayerPlot:FindFirstChildWhichIsA(

                        "BasePart",

                        true

                    )

                if Part then

                    return Part

                end

            end

            -- UserId*

            local UserIdPlot =

                Container:FindFirstChild(

                    tostring(

                        Player.UserId

                    )

                )

            if UserIdPlot then

                local Part =

                    UserIdPlot:FindFirstChildWhichIsA(

                        "BasePart",

                        true

                    )

                if Part then

                    return Part

                end

            end

            -- Owner attributes*

            for _, Plot in ipairs(

                Container:GetChildren()

            ) do

                local Owner =

                    Plot:GetAttribute(

                        "Owner"

                    )

                local OwnerUserId =

                    Plot:GetAttribute(

                        "OwnerUserId"

                    )

                if Owner == Player.Name

                    or Owner == Player.UserId

                    or OwnerUserId

                        == Player.UserId

                    or OwnerUserId

                        == tostring(

                            Player.UserId

                        )

                then

                    local Part =

                        Plot:FindFirstChildWhichIsA(

                            "BasePart",

                            true

                        )

                    if Part then

                        return Part

                    end

                end

            end

        end

    end

    -- Additional generic search*

    for _, Object in ipairs(

        workspace:GetDescendants()

    ) do

        if Object:IsA("BasePart") then

            local Parent =

                Object.Parent

            if Parent then

                local Owner =

                    Parent:GetAttribute(

                        "Owner"

                    )

                local OwnerUserId =

                    Parent:GetAttribute(

                        "OwnerUserId"

                    )

                if Owner == Player.Name

                    or Owner == Player.UserId

                    or OwnerUserId

                        == Player.UserId

                    or OwnerUserId

                        == tostring(

                            Player.UserId

                        )

                then

                    return Object

                end

            end

        end

    end

    return nil

end

--==================================================*

-- TWEEN TO PLOT*

--==================================================*

local function TweenToPlot()

    local Character =

        GetCharacter()

    if not Character then

        return false

    end

    local HRP =

        Character:FindFirstChild(

            "HumanoidRootPart"

        )

    if not HRP then

        return false

    end

    local PlotPart =

        FindPlotTarget()

    if not PlotPart then

        warn(

            "Plot target not found. Not using TeleportToPlot remote."

        )

        return false

    end

    CancelCurrentTween()

    local TargetCFrame =

        PlotPart.CFrame

        * CFrame.new(0, 3, 0)

    local Distance =

        (

            HRP.Position

            - TargetCFrame.Position

        ).Magnitude

    local Duration =

        Distance / math.max(

            TweenSpeed,

            1

        )

    -- Already at plot*

    if Distance <= 1 then

        HRP.CFrame =

            TargetCFrame

        return true

    end

    -- Smooth straight tween*

    CurrentTween =

        TweenService:Create(

            HRP,

            TweenInfo.new(

                Duration,

                Enum.EasingStyle.Linear,

                Enum.EasingDirection.Out

            ),

            {

                CFrame = TargetCFrame

            }

        )

    local Finished = false

    local Connection

    Connection =

        CurrentTween.Completed:Connect(

            function()

                Finished = true

                if Connection then

                    Connection:Disconnect()

                end

            end

        )

    CurrentTween:Play()

    while not Finished do

        if not AutoPickup then

            CancelCurrentTween()

            return false

        end

        task.wait()

    end

    CurrentTween = nil

    return true

end

