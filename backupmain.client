})


--------------------------------------------------------WINDOW 2 INFO-------------------------------------------------------------------

local AutoStealSection = Tab2:Section({
	Title = "AUTO STEAL",
	IconThemed = true,
	Box = true,
	BoxBorder = true,
})

AutoStealSection:Toggle({
	Title = "Auto-Steal",
	Default = false,
	Callback = function(Value)
		if Value then
			AutoStealEggs()
		else
			print("Auto Steal Eggs disabled!")
		end
	end,
})

AutoStealSection:Toggle({
	Title = "Persistent Steal",
	Default = false,
	Callback = function(Value)
		if Value then
			AutoStealEggs()
		else
			print("Auto Steal Eggs disabled!")
		end
	end,
})

AutoStealSection:Toggle({
	Title = "Prevent Traps",
	Default = false,
	Callback = function(Value)
		if Value then
			AutoStealEggs()
		else
			print("Auto Steal Eggs disabled!")
		end
	end,
})


AutoStealSection:Slider({
	Title = "Tween Speed",
	Step = 1,
	Width = 200,
	Value = {
		Min = 100,
		Max = 1000,
		Default = 1000,
	},
	Callback = function(value)
		print(value)
	end,
})

AutoStealSection:Input({
	Title = "Exact Tween Speed",
     Value = "1000",
	Callback = function(value)
		print("Input:", value)
	end,
})

AutoStealSection:Toggle({
	Title = "Auto Calibrate Speed",
	Default = false,
	Callback = function(Value)
		if Value then
			AutoStealEggs()
		else
			print("Auto Steal Eggs disabled!")
		end
	end,
})

AutoStealSection:Dropdown({
