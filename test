-- AUTO FARM LOOP
task.spawn(function()
	while true do
		if AutoPickup then
			local Egg = FindSelectedEgg()

			if Egg then
				local EggPart = GetEggPart(Egg)
				local EggPosition = EggPart and EggPart.Position

				-- 1. Teleport to Egg
				if TeleportToEgg(Egg) then
					-- MAY 2 SECONDS DELAY BAGO PICKUP
					task.wait(2)

					-- Trigger Pickup
					PickupEgg(Egg)

					-- Wait hanggang sa ma-pickup/mawala ang Egg
					WaitForEggPickup(Egg, 3)

					-- 2. Teleport sa X, Z ng Egg gamit ang Y height na 39771.2422
					if EggPosition then
						TeleportToEggVoid(EggPosition)
					end

					-- 3. Wait para sa auto-respawn / auto-tp pabalik sa plot
					task.wait(4)
				else
					task.wait(0.1)
				end
			else
				task.wait(0.2)
			end
		else
			task.wait(0.2)
		end

		task.wait(0.03)
	end
end)
