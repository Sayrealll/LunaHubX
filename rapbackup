--==================================================
-- CHARACTER
--==================================================

local function GetCharacter()

	local Character =
		Player.Character

	if not Character then
		return nil
	end

	local Humanoid =
		Character:FindFirstChildOfClass(
			"Humanoid"
		)

	local HRP =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not Humanoid or not HRP then
		return nil
	end

	return Character
end


--==================================================
-- FIND EGG PART
--==================================================

local function GetEggPart(Egg)

	if not Egg then
		return nil
	end

	if Egg:IsA("BasePart") then
		return Egg
	end

	if Egg:IsA("Model") then

		if Egg.PrimaryPart then
			return Egg.PrimaryPart
		end

		local Pickup =
			Egg:FindFirstChild(
				"Pickup",
				true
			)

		if Pickup
			and Pickup:IsA("ProximityPrompt")
		then

			local Parent =
				Pickup.Parent

			if Parent
				and Parent:IsA("BasePart")
			then

				return Parent
			end
		end

		return Egg:FindFirstChildWhichIsA(
			"BasePart",
			true
		)
	end

	return nil
end


--==================================================
-- FIND HIGHEST PRIORITY SELECTED EGG
--==================================================

local function FindSelectedEgg()

	local BestEgg = nil

	local HighestPriority =
		math.huge

	for _, Egg in ipairs(
		RenderedEggs:GetChildren()
	) do

		-- IMPORTANT:
		-- Huwag kunin ulit ang egg na
		-- kasalukuyang pinoproseso/nakuha na.
		if not ProcessedEggs[Egg] then

			local Name =
				Egg.Name

			local IsSelected = false

			if type(SelectedEggs) == "table" then

				for _, SelectedName in ipairs(
					SelectedEggs
				) do

					if SelectedName == Name then

						IsSelected = true

						break
					end
				end

			elseif SelectedEggs == Name then

				IsSelected = true

			end

			if IsSelected then

				local Priority =
					EggPriority[Name]
					or 999

				if Priority <
					HighestPriority
				then

					HighestPriority =
						Priority

					BestEgg =
						Egg
				end
			end
		end
	end

	return BestEgg
end


--==================================================
-- FIND PICKUP PROMPT
--==================================================

local function FindPickup(Egg)

	if not Egg then
		return nil
	end

	for _, Descendant in ipairs(
		Egg:GetDescendants()
	) do

		if Descendant:IsA(
			"ProximityPrompt"
		) then

			if Descendant.Name == "Pickup" then

				return Descendant

			end
		end
	end

	return nil
end


--==================================================
-- INSTANT TELEPORT TO EGG
--==================================================

local function TeleportToEgg(Egg)

	local Character =
		GetCharacter()

	if not Character then
		return false
	end

	local HRP =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not HRP then
		return false
	end

	local EggPart =
		GetEggPart(Egg)

	if not EggPart then
		return false
	end

	if not Egg
		or not Egg.Parent
	then
		return false
	end

	HRP.CFrame =
		EggPart.CFrame
		* CFrame.new(
			0,
			2.5,
			0
		)

	return true
end


--==================================================
-- PICKUP EGG
--==================================================

local function PickupEgg(Egg)

	local Prompt =
		FindPickup(Egg)

	if not Prompt then
		return false
	end

	-- Executor method
	if typeof(
		fireproximityprompt
	) == "function"
	then

		local Success =
			pcall(function()

				fireproximityprompt(
					Prompt
				)

			end)

		if Success then
			return true
		end
	end

	-- Fallback
	local Success =
		pcall(function()

			Prompt:InputHoldBegin()

			task.wait(
				math.max(
					Prompt.HoldDuration,
					0.05
				)
			)

			Prompt:InputHoldEnd()

		end)

	return Success
end


--==================================================
-- CHECK IF EGG IS BEING HELD
--==================================================

local function IsHoldingEgg(Egg)

	local Character =
		GetCharacter()

	if not Character then
		return false
	end

	-- Check exact egg name first
	if Egg then

		for _, Object in ipairs(
			Character:GetDescendants()
		) do

			if Object.Name ==
				Egg.Name
			then

				return true
			end
		end
	end

	-- Check generic egg object
	for _, Object in ipairs(
		Character:GetDescendants()
	) do

		local ObjectName =
			string.lower(
				Object.Name
			)

		if string.find(
			ObjectName,
			"egg",
			1,
			true
		) then

			return true
		end
	end

	-- If the exact egg disappeared
	-- from RenderedEggs, pickup was registered.
	if Egg
		and not Egg.Parent
	then

		return true
	end

	return false
end


--==================================================
-- WAIT FOR PICKUP
--==================================================

local function WaitForEggPickup(Egg)

	local StartTime =
		tick()

	while AutoPickup
		and (
			tick()
			- StartTime
		) < 2
	do

		if IsHoldingEgg(Egg) then

			return true

		end

		task.wait(0.03)
	end

	return false
end


--==================================================
-- FIND PLAYER PLOT
--==================================================

local function FindPlotTarget()

	local PossibleContainers = {

		workspace:FindFirstChild(
			"Plots"
		),

		workspace:FindFirstChild(
			"Plot"
		),

		workspace:FindFirstChild(
			"PlayerPlots"
		),

		workspace:FindFirstChild(
			"PlotsFolder"
		)
	}

	for _, Container in ipairs(
		PossibleContainers
	) do

		if Container then

			-- Player name
			local PlayerPlot =
				Container:FindFirstChild(
					Player.Name
				)

			if PlayerPlot then

				local Part =
					PlayerPlot:FindFirstChildWhichIsA(
						"BasePart",
						true
					)

				if Part then
					return Part
				end
			end

			-- UserId
			local UserIdPlot =
				Container:FindFirstChild(
					tostring(
						Player.UserId
					)
				)

			if UserIdPlot then

				local Part =
					UserIdPlot:FindFirstChildWhichIsA(
						"BasePart",
						true
					)

				if Part then
					return Part
				end
			end

			-- Attributes
			for _, Plot in ipairs(
				Container:GetChildren()
			) do

				local Owner =
					Plot:GetAttribute(
						"Owner"
					)

				local OwnerUserId =
					Plot:GetAttribute(
						"OwnerUserId"
					)

				if Owner == Player.Name
					or Owner == Player.UserId
					or OwnerUserId
						== Player.UserId
					or OwnerUserId
						== tostring(
							Player.UserId
						)
				then

					local Part =
						Plot:FindFirstChildWhichIsA(
							"BasePart",
							true
						)

					if Part then
						return Part
					end
				end
			end
		end
	end

	-- Global fallback
	for _, Object in ipairs(
		workspace:GetDescendants()
	) do

		if Object:IsA("BasePart") then

			local Parent =
				Object.Parent

			if Parent then

				local Owner =
					Parent:GetAttribute(
						"Owner"
					)

				local OwnerUserId =
					Parent:GetAttribute(
						"OwnerUserId"
					)

				if Owner == Player.Name
					or Owner == Player.UserId
					or OwnerUserId
						== Player.UserId
					or OwnerUserId
						== tostring(
							Player.UserId
						)
				then

					return Object
				end
			end
		end
	end

	return nil
end


--==================================================
-- TELEPORT TO MY PLOT
--==================================================

local function TeleportToMyPlot()

	local Character =
		GetCharacter()

	if not Character then
		return false
	end

	local HRP =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not HRP then
		return false
	end

	--==================================================
	-- METHOD 1
	-- GAME'S OWN PLOT TELEPORT BUTTON
	--==================================================

	local PlayerGui =
		Player:FindFirstChild(
			"PlayerGui"
		)

	if PlayerGui then

		local Main =
			PlayerGui:FindFirstChild(
				"Main"
			)

		if Main then

			local PlotTeleport =
				Main:FindFirstChild(
					"PlotTeleport"
				)

			if PlotTeleport then

				local Fired = false

				-- MouseButton1Click
				pcall(function()

					local Connections =
						getconnections(
							PlotTeleport.MouseButton1Click
						)

					for _, Connection in pairs(
						Connections
					) do

						Connection:Fire()

						Fired = true
					end
				end)

				-- Activated
				pcall(function()

					local Connections =
						getconnections(
							PlotTeleport.Activated
						)

					for _, Connection in pairs(
						Connections
					) do

						Connection:Fire()

						Fired = true
					end
				end)

				-- Give the game a moment to process
				if Fired then

					local OldPosition =
						HRP.Position

					local StartTime =
						tick()

					while (
						tick()
						- StartTime
					) < 0.5
					do

						task.wait(0.03)

						if not HRP.Parent then
							return true
						end

						if (
							HRP.Position
							- OldPosition
						).Magnitude > 5
						then

							return true
						end
					end

					-- Even if the GUI teleport did not
					-- visibly move us, continue to fallback.
				end
			end
		end
	end

	--==================================================
	-- METHOD 2
	-- DIRECT PLAYER PLOT TELEPORT FALLBACK
	--==================================================

	local PlotPart =
		FindPlotTarget()

	if PlotPart then

		-- Instant teleport
		HRP.CFrame =
			PlotPart.CFrame
			* CFrame.new(
				0,
				5,
				0
			)

		task.wait(0.05)

		-- Force final position once more
		-- to prevent staying at the egg.
		if HRP.Parent then

			HRP.CFrame =
				PlotPart.CFrame
				* CFrame.new(
					0,
					5,
					0
				)

		end

		return true
	end

	warn(
		"LUNA HUB: Player plot could not be found."
	)

	return false
end


