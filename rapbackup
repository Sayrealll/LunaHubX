--==================================================
-- AUTO PICKUP / AUTO FARM LOOP
--==================================================

task.spawn(function()

	while true do

		if AutoPickup then

			-- FIND SELECTED / HIGHEST PRIORITY EGG
			local Egg =
				FindSelectedEgg()

			if Egg then

				--================================================
				-- 1. TELEPORT TO EGG
				--================================================

				local ReachedEgg =
					TeleportToEgg(Egg)

				if ReachedEgg then

					task.wait(0.05)

					--================================================
					-- 2. GET / PICKUP EGG
					--================================================

					local PickedUp =
						PickupEgg(Egg)

					if PickedUp then

						--================================================
						-- WAIT UNTIL EGG IS ACTUALLY HELD
						--================================================

						local PickupRegistered =
							WaitForEggPickup(
								Egg
							)

						if PickupRegistered then

							--================================================
							-- 3. TELEPORT TO MY PLOT
							--================================================

							TeleportToMyPlot()

							task.wait(0.2)

						else

							task.wait(0.1)

						end

					else

						task.wait(0.1)

					end

				else

					task.wait(0.1)

				end

			else

				-- Walang selected/available egg
				task.wait(0.15)

			end

		else

			task.wait(0.2)

		end

		task.wait(0.03)

	end
end)
