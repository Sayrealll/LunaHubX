--==================================================
-- AUTO PICKUP LOOP
-- ONE EGG AT A TIME
--==================================================

task.spawn(function()

	while true do

		if AutoPickup
			and not IsProcessingEgg
		then

			--==================================================
			-- FIND ONE EGG
			--==================================================

			local Egg =
				FindSelectedEgg()

			if Egg
				and Egg.Parent
			then

				-- LOCK THE WHOLE CYCLE
				IsProcessingEgg = true

				-- Mark this exact egg instance
				-- immediately so it cannot be
				-- selected again.
				ProcessedEggs[Egg] = true

				--==================================================
				-- 1. TELEPORT TO EGG
				--==================================================

				local ReachedEgg =
					TeleportToEgg(Egg)

				if ReachedEgg then

					task.wait(0.05)

					--==================================================
					-- 2. PICKUP ONCE
					--==================================================

					local PickedUp =
						PickupEgg(Egg)

					if PickedUp then

						--==================================================
						-- 3. WAIT UNTIL PICKUP IS CONFIRMED
						--==================================================

						local PickupRegistered =
							WaitForEggPickup(
								Egg
							)

						if PickupRegistered then

							--==================================================
							-- 4. TELEPORT TO OWN PLOT
							--==================================================

							TeleportToMyPlot()

							-- Wait before allowing
							-- another egg cycle.
							task.wait(0.2)

						end
					end
				end

				--==================================================
				-- CURRENT EGG FINISHED
				-- NOW ALLOW NEXT EGG
				--==================================================

				IsProcessingEgg = false

			else

				task.wait(0.15)

			end

		else

			if not AutoPickup then

				IsProcessingEgg = false
				ProcessedEggs = {}

			end

			task.wait(0.2)

		end

		-- Clean destroyed egg instances
		for Egg in pairs(
			ProcessedEggs
		) do

			if not Egg
				or not Egg.Parent
			then

				ProcessedEggs[Egg] = nil

			end
		end

		task.wait(0.03)

	end
end)
