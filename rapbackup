--==================================================
-- AUTO PICKUP / AUTO FARM
--==================================================

task.spawn(function()

	while true do

		if AutoPickup then

			--================================================
			-- STEP 1
			-- FIND SELECTED EGG IN RENDERED EGGS
			--================================================

			local Egg =
				FindSelectedEgg()

			if Egg
				and Egg.Parent
			then

				--================================================
				-- STEP 2
				-- TELEPORT DIRECTLY TO THE EGG
				--================================================

				local ReachedEgg =
					TeleportToEgg(Egg)

				if ReachedEgg then

					-- Small delay so the character
					-- reaches the egg position.
					task.wait(0.05)

					--================================================
					-- STEP 3
					-- AUTOMATICALLY PICK UP THE EGG
					--================================================

					local PickedUp =
						PickupEgg(Egg)

					if PickedUp then

						--================================================
						-- STEP 4
						-- WAIT FOR ACTUAL SUCCESSFUL PICKUP
						--================================================

						local SuccessfullyHolding =
							WaitForEggPickup(Egg)

						--================================================
						-- STEP 5
						-- ONLY NOW TELEPORT TO OWN PLOT
						--================================================

						if SuccessfullyHolding then

							TeleportToMyPlot()

							-- Small delay before searching
							-- for the next egg.
							task.wait(0.2)

						else

							-- Egg was not confirmed as picked up.
							-- DO NOT teleport to plot.
							task.wait(0.1)

						end

					else

						-- Pickup failed.
						-- DO NOT teleport to plot.
						task.wait(0.1)

					end

				else

					task.wait(0.1)

				end

			else

				--================================================
				-- NO SELECTED EGG CURRENTLY RENDERED
				--================================================

				task.wait(0.15)
			end

		else

			task.wait(0.2)

		end

		task.wait(0.03)
	end
end)
