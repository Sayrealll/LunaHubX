--==================================================
-- AUTO FARM LOOP
--==================================================

task.spawn(function()

	while true do

		if AutoPickup then

			--================================================
			-- 1. DETECT SELECTED EGG
			--================================================

			local Egg =
				FindSelectedEgg()

			if Egg
				and Egg.Parent
			then

				--================================================
				-- 2. INSTANT TELEPORT TO EGG
				--================================================

				local ReachedEgg =
					TeleportToEgg(Egg)

				if ReachedEgg then

					task.wait(0.05)

					--================================================
					-- 3. AUTOMATICALLY PICKUP EGG
					--================================================

					local PickedUp =
						PickupEgg(Egg)

					if PickedUp then

						--================================================
						-- 4. CONFIRM ACTUAL PICKUP
						--================================================

						local PickupRegistered =
							WaitForEggPickup(
								Egg
							)

						if PickupRegistered then

							--================================================
							-- 5. INSTANT TELEPORT TO OWN PLOT
							--================================================

							TeleportToMyPlot()

							task.wait(0.2)

						else

							-- Pickup was not confirmed.
							-- DO NOT go to plot.
							task.wait(0.1)

						end

					else

						-- Pickup failed.
						-- DO NOT go to plot.
						task.wait(0.1)

					end

				else

					task.wait(0.1)

				end

			else

				-- Selected egg isn't currently rendered.
				task.wait(0.15)

			end

		else

			task.wait(0.2)

		end

		task.wait(0.03)
	end
end)
