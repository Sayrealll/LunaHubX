-- AUTO FARM LOOP (TELEPORTATION LOGIC)
task.spawn(function()
	while true do
		if AutoPickup then
			local Egg = FindSelectedEgg()

			if Egg then
				-- Step 1: Teleport to Egg
				if TeleportToEgg(Egg) then
					task.wait(0.1)

					-- Step 2: Get Egg
					PickupEgg(Egg)

					-- Step 3: Delay ng 3 seconds habang nasa Egg area
					task.wait(3)

					-- Step 4: Teleport to Plot
					TeleportToPlot()

					-- Step 5: Delay ng 3 seconds habang nasa Plot bago kumuha ulit
					task.wait(3)
				else
					task.wait(0.1)
				end
			else
				task.wait(0.15)
			end
		else
			task.wait(0.2)
		end

		task.wait(0.03)
	end
end)
