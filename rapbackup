--// CHARACTER

local function GetCharacter()

	return Player.Character
		or Player.CharacterAdded:Wait()

end

--// GET EGG PART

local function GetEggPart(Egg)

	if not Egg then
		return nil
	end

	if Egg:IsA("BasePart") then
		return Egg
	end

	if Egg:IsA("Model") then

		if Egg.PrimaryPart then
			return Egg.PrimaryPart
		end

		local Part =
			Egg:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

		if Part then
			return Part
		end

	end

	return nil

end

--// FIND SELECTED EGG

local function FindSelectedEgg()

	if not RenderedEggs then
		return nil
	end

	-- Follow the selected egg priority
	for Index = 1, #EggPriority do

		local EggName =
			EggPriority[Index]

		local IsSelected = false

		if SelectedEggs[EggName] then
			IsSelected = true
		end

		-- Support array-style multiselect values
		if not IsSelected then

			for _, SelectedName in pairs(SelectedEggs) do

				if SelectedName == EggName then
					IsSelected = true
					break
				end

			end

		end

		if IsSelected then

			for _, Egg in ipairs(
				RenderedEggs:GetChildren()
			) do

				if Egg.Name == EggName
					and Egg.Parent
					and not ProcessedEggs[Egg]
				then

					return Egg

				end

			end

		end

	end

	return nil

end

--// FIND PICKUP PROMPT

local function FindPickup(Egg)

	if not Egg then
		return nil
	end

	for _, Object in ipairs(
		Egg:GetDescendants()
	) do

		if Object:IsA("ProximityPrompt") then
			return Object
		end

	end

	if Egg:IsA("ProximityPrompt") then
		return Egg
	end

	return nil

end

--// TELEPORT TO EGG

local function TeleportToEgg(Egg)

	local Character =
		GetCharacter()

	if not Character then
		return false
	end

	local HRP =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not HRP then
		return false
	end

	local EggPart =
		GetEggPart(Egg)

	if not EggPart then
		return false
	end

	if not Egg
		or not Egg.Parent
	then
		return false
	end

	HRP.CFrame =
		EggPart.CFrame
		* CFrame.new(
			0,
			2.5,
			0
		)

	return true

end

--// PICKUP EGG

local function PickupEgg(Egg)

	local Prompt =
		FindPickup(Egg)

	if not Prompt then
		return false
	end

	-- Executor fireproximityprompt
	if typeof(fireproximityprompt) == "function" then

		local Success =
			pcall(function()

				fireproximityprompt(
					Prompt
				)

			end)

		if Success then
			return true
		end

	end

	-- Fallback
	local Success =
		pcall(function()

			Prompt:InputHoldBegin()

			task.wait(
				math.max(
					Prompt.HoldDuration,
					0.05
				)
			)

			Prompt:InputHoldEnd()

		end)

	return Success

end

--// CHECK IF EGG WAS PICKED UP

local function IsHoldingEgg(Egg)

	local Character =
		GetCharacter()

	if not Character then
		return false
	end

	-- Check character descendants
	for _, Object in ipairs(
		Character:GetDescendants()
	) do

		local ObjectName =
			string.lower(
				Object.Name
			)

		if string.find(
			ObjectName,
			"egg",
			1,
			true
		) then

			return true

		end

		if Egg
			and Object.Name == Egg.Name
		then

			return true

		end

	end

	-- Egg disappearing from RenderedEggs
	-- means the pickup was registered
	if Egg
		and not Egg.Parent
	then

		return true

	end

	return false

end

--// WAIT FOR PICKUP CONFIRMATION

local function WaitForEggPickup(Egg)

	local StartTime =
		tick()

	while AutoPickup
		and (tick() - StartTime) < 2
	do

		if IsHoldingEgg(Egg) then
			return true
		end

		task.wait(0.03)

	end

	return false

end

--// TELEPORT TO MY PLOT

local function TeleportToMyPlot()

	local player =
		game:GetService(
			"Players"
		).LocalPlayer

	local mainGui =
		player:WaitForChild(
			"PlayerGui"
		):WaitForChild(
			"Main"
		)

	local plotTeleport =
		mainGui:FindFirstChild(
			"PlotTeleport"
		)

	-- Method 1: Fires the game's built-in GUI teleport directly
	if plotTeleport then

		for _, connection in pairs(
			getconnections(
				plotTeleport.MouseButton1Click
			)
		) do

			connection:Fire()

		end

		for _, connection in pairs(
			getconnections(
				plotTeleport.Activated
			)
		) do

			connection:Fire()

		end

		return true

	end

	-- Method 2: Fallback scan
	local character =
		player.Character
		or player.CharacterAdded:Wait()

	local rootPart =
		character:WaitForChild(
			"HumanoidRootPart"
		)

	local plots =
		workspace:FindFirstChild(
			"Plots"
		)

	if plots then

		for _, plot in pairs(
			plots:GetChildren()
		) do

			for _, descendant in pairs(
				plot:GetDescendants()
			) do

				if (
					descendant:IsA("TextLabel")
					or descendant:IsA("SurfaceGui")
				)
				and descendant.Text
				then

					if descendant.Text:find(
						player.Name
					)
					or descendant.Text:find(
						player.DisplayName
					)
					then

						rootPart.CFrame =
							plot:GetPivot()
							+ Vector3.new(
								0,
								5,
								0
							)

						return true

					end

				elseif (
					descendant:IsA("StringValue")
					or descendant:IsA("ObjectValue")
				)
				then

					if tostring(
						descendant.Value
					):find(
						player.Name
					)
					then

						rootPart.CFrame =
							plot:GetPivot()
							+ Vector3.new(
								0,
								5,
								0
							)

						return true

					end

				end

			end

		end

	end

	return false

end

--// AUTO FARM
--// ONE EGG AT A TIME

task.spawn(function()

	while true do

		if AutoPickup
			and not IsProcessingEgg
		then

			local Egg =
				FindSelectedEgg()

			if Egg
				and Egg.Parent
				and not ProcessedEggs[Egg]
			then

				-- LOCK
				-- Nothing else can start while
				-- this egg is being processed.
				IsProcessingEgg = true

				-- Mark this exact egg instance
				-- so it cannot be selected again.
				ProcessedEggs[Egg] = true

				--==================================================
				-- STEP 1: TELEPORT TO EGG
				--==================================================

				local ReachedEgg =
					TeleportToEgg(Egg)

				if ReachedEgg then

					task.wait(0.05)

					--==================================================
					-- STEP 2: PICKUP ONCE
					--==================================================

					local PickedUp =
						PickupEgg(Egg)

					if PickedUp then

						--==================================================
						-- STEP 3: WAIT FOR SUCCESSFUL PICKUP
						--==================================================

						local PickupRegistered =
							WaitForEggPickup(Egg)

						if PickupRegistered then

							--==================================================
							-- STEP 4: TELEPORT TO PLOT
							--==================================================

							TeleportToMyPlot()

							task.wait(0.2)

						end

					end

				end

				--==================================================
				-- CURRENT EGG CYCLE FINISHED
				-- Only now can another egg be selected.
				--==================================================

				IsProcessingEgg = false

			end

		elseif not AutoPickup then

			IsProcessingEgg = false
			ProcessedEggs = {}

		end

		-- Remove old egg instances
		for Egg in pairs(ProcessedEggs) do

			if not Egg
				or not Egg.Parent
			then

				ProcessedEggs[Egg] = nil

			end

		end

		task.wait(0.05)

	end

end)

--// AUTO CLAIM INDEX

local function ClaimIndexReward()

	local Character =
		GetCharacter()

	if not Character then
		return
	end

	-- Existing game interaction scan
	for _, Object in ipairs(
		workspace:GetDescendants()
	) do

		if Object:IsA("ProximityPrompt") then

			local Name =
				string.lower(
					Object.Name
				)

			if string.find(
				Name,
				"claim",
				1,
				true
			)
			or string.find(
				Name,
				"index",
				1,
				true
			)
			then

				pcall(function()

					if typeof(
						fireproximityprompt
					) == "function"
					then

						fireproximityprompt(
							Object
						)

					end

				end)

			end

		end

	end

end

