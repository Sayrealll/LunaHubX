-- gumagawa ng loader code (string) na tatakbo pagkatapos mag-teleport / pag-open ng Roblox
LH.BuildLoader = function(checkConfig, checkFlag)
	local parts = {}
	local function add(line) parts[#parts + 1] = line end

	add('local env = (getgenv and getgenv()) or _G')
	add('if env.__LunaHubBoot then return end')
	add('env.__LunaHubBoot = true')
	add('task.delay(30, function() env.__LunaHubBoot = nil end)')
	add('if not game:IsLoaded() then game.Loaded:Wait() end')
	-- tamang ID ng Ride A Pet: tinatanggap kung tumugma sa PlaceId o GameId
	add(string.format('if game.PlaceId ~= %d and game.GameId ~= %d then env.__LunaHubBoot = nil return end', LH.GameID, LH.GameID))

	if checkConfig then
		add('local okc, cfg = pcall(function()')
		add(string.format('\treturn game:GetService("HttpService"):JSONDecode(readfile(%q))', ConfigFile))
		add('end)')
		add('if not (okc and type(cfg) == "table" and cfg.AutoExecute == true) then env.__LunaHubBoot = nil return end')
	end

	if checkFlag then
		add(string.format('if isfile and not isfile(%q) then env.__LunaHubBoot = nil return end', LH.QueueFlag))
	end

	add('task.wait(2)')
	add('local src')
	add(string.format('local url = %q', LH.GetSourceURL()))
	add('if url ~= "" then')
	add('\tlocal ok, r = pcall(function() return game:HttpGet(url) end)')
	add('\tif ok and type(r) == "string" and #r > 0 then src = r end')
	add('end')
	add('if not src and isfile and readfile then')
	add(string.format('\tif isfile(%q) then', LH.SourceFile))
	add(string.format('\t\tlocal ok, r = pcall(readfile, %q)', LH.SourceFile))
	add('\t\tif ok and type(r) == "string" and #r > 0 then src = r end')
	add('\tend')
	add('end')
	add('if not src then env.__LunaHubBoot = nil return end')
	add('local fn, err = loadstring(src)')
	add('if fn then task.spawn(fn) else warn("[LunaHub] loader error: " .. tostring(err)) end')

	return table.concat(parts, "\n")
end

-- QUEUE ON TELEPORT: kapag nag server hop / rejoin / teleport, kusang mag-oopen ulit ang script
LH.QueueTeleport = function()
	if LH.Queued then return true end
	if not LH.QueueFn then return false end
	if not LH.HasSource() then return false end

	local flagOk = false
	if writefile then
		EnsureFolders()
		flagOk = pcall(writefile, LH.QueueFlag, tostring(os.time()))
	end

	local ok = pcall(LH.QueueFn, LH.BuildLoader(false, flagOk))
	if ok then LH.Queued = true end
	return ok
end

LH.ClearQueueFlag = function()
	if delfile and isfile then
		pcall(function()
			if isfile(LH.QueueFlag) then delfile(LH.QueueFlag) end
		end)
	end
end

-- AUTO EXECUTE: nagse-save ng loader sa autoexec folder ng executor
LH.AutoExecDirs = {}
for _, prefix in ipairs({ "", "../" }) do
	for _, name in ipairs({ "autoexec", "Autoexec", "AutoExec", "autoexecute", "Autoexecute", "AutoExecute", "Auto Execute" }) do
		table.insert(LH.AutoExecDirs, prefix .. name)
	end
end

LH.InstallAutoExec = function()
	local installed = {}
	if not writefile then return installed end

	local loader = "-- LUNA HUB (Ride A Pet) auto execute loader\n" .. LH.BuildLoader(true, false)

	-- kopya sa workspace (para madali mong mailipat manually kung hindi ma-detect ang folder)
	EnsureFolders()
	pcall(writefile, LH.LoaderFile, loader)

	for _, dir in ipairs(LH.AutoExecDirs) do
		local exists = false
		if isfolder then
			local ok, res = pcall(isfolder, dir)
			exists = ok and res == true
		end
		if exists then
			local path = dir .. "/" .. LH.AutoExecName
			local wrote = pcall(writefile, path, loader)
			if wrote then
				local verified = true
				if isfile then
					local okv, rv = pcall(isfile, path)
					verified = okv and rv == true
				end
				if verified then table.insert(installed, path) end
			end
		end
	end

	return installed
end

LH.RemoveAutoExec = function()
	if not (delfile and isfile) then return end
	local paths = { LH.LoaderFile }
	for _, dir in ipairs(LH.AutoExecDirs) do
		table.insert(paths, dir .. "/" .. LH.AutoExecName)
	end
	for _, path in ipairs(paths) do
		pcall(function()
			if isfile(path) then delfile(path) end
		end)
	end
end

