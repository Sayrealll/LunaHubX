			if workspace:GetServerTimeNow() >= endsAt then
				if not GoToMachine() then return end
				ActionRemote:FireServer("Fuse")
				task.wait(6) -- hayaan munang tumakbo ang reveal (~5s)
			end
		end
	end

	task.spawn(function()
		while LH.Alive do
			if AutoClaimFusedPets then
				pcall(RunAutoClaimFused)
				task.wait(1.5)
