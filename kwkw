		if depth > 4 then return end
		if type(value) == "string" then
			if #value >= 30 and string.find(value, "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-") then
				table.insert(out, value)
			end
		elseif type(value) == "table" then
