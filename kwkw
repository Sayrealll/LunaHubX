--// Posisyon sa LABAS ng plot (relative sa Baseplate). I-adjust kung mali ang side.
LH.OutsideHeight = 5   -- taas mula sa baseplate
LH.OutsideExtra  = 30  -- dagdag na studs lampas sa gilid ng baseplate

-- TP sa LABAS ng plot, sa side kung nasaan ang egg (kanan / kaliwa / taas / baba)
-- refPos = posisyon ng egg (kung wala, gagamitin ang posisyon ng player)
function LH.TeleportOutsidePlot(hrp, refPos)
	local plot = LH.GetMyPlot()
	local base = plot and plot:FindFirstChild("Baseplate")

	if not (base and base:IsA("BasePart")) then
		return false
	end

	-- posisyon ng egg relative sa baseplate
	local o = base.CFrame:PointToObjectSpace(refPos or hrp.Position)

	local halfX = base.Size.X / 2
	local halfZ = base.Size.Z / 2

	-- alin ang mas malapit na gilid: kaliwa/kanan (X) o taas/baba (Z)?
	local nx = o.X / halfX
	local nz = o.Z / halfZ

	local offset
	if math.abs(nx) >= math.abs(nz) then
		local side = (o.X >= 0) and 1 or -1
		offset = Vector3.new((halfX + LH.OutsideExtra) * side, LH.OutsideHeight, 0)
	else
		-- kung baliktad ang taas/baba sa in-game, palitan ng: (o.Z >= 0) and -1 or 1
		local side = (o.Z >= 0) and 1 or -1
		offset = Vector3.new(0, LH.OutsideHeight, (halfZ + LH.OutsideExtra) * side)
	end

	hrp.CFrame = LH.UprightCFrame((base.CFrame * CFrame.new(offset)).Position)
	LH.Stabilize()

	return true
end

