			return
		end

		-- 2) Walang resulta pa: kung tapos na ang timer ("Ready"), ipadala ang "Fuse"
		local slots = LocalPlayer:FindFirstChild("FusionSlots")
		if slots and slots:GetAttribute("FusionStatus") == "Waiting" then
