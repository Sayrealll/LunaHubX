function LH.FindDroppedEgg(eggName, hrp)
	local best, bestDist = nil, 80
	local fallback, fallbackDist = nil, 80
	for _, e in ipairs(RenderedEggs:GetChildren()) do
		local part = GetEggPart(e)
		if part then
			local d = (part.Position - hrp.Position).Magnitude
			if e.Name == eggName and d < bestDist then
				best, bestDist = e, d
			elseif d < fallbackDist then
				fallback, fallbackDist = e, d
			end
		end
	end
	return best or fallback
end

function LH.DropAndRepickup(eggName, hrp, eggPos)
	if not LH.TeleportOutsidePlot(hrp, eggPos) then return nil end
	task.wait(0.5)

	pcall(function() LH.BasketDrop:FireServer() end)
	LH.WaitForBasketEmpty(0.1)
	task.wait(0.1)

	for _ = 1, 5 do
		local dropped = LH.FindDroppedEgg(eggName, hrp)
		if dropped then
			local part = GetEggPart(dropped)
			if part then hrp.CFrame = LH.UprightCFrame(part.Position + Vector3.new(0, 3, 0)); LH.Stabilize() end
			task.wait(0.1)
			local newBasketEgg = PickupAndConfirm(dropped)
			if newBasketEgg then return newBasketEgg end
		end
		task.wait(0.3)
	end
	return nil
end

