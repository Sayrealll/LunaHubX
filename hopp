-- DRAGGING LOGIC
local dragging, dragStart, startPos
local function updateInput(input)
    local delta = input.Position - dragStart
    MainContainer.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainContainer.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateInput(input)
    end
end)

-- LONG PRESS CLOSE & SHORT CLICK MINIMIZE LOGIC
local pressThread = nil
local isLongPress = false
local LONG_PRESS_TIME = 1.5

ToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isLongPress = false
        pressThread = task.delay(LONG_PRESS_TIME, function()
            isLongPress = true
            ScreenGui:Destroy()
            PersistentGui:Destroy()
        end)
    end
end)

ToggleBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if pressThread then
            task.cancel(pressThread)
            pressThread = nil
        end
        
        if not isLongPress then
            Frame.Visible = not Frame.Visible
            ToggleBtn.Text = Frame.Visible and "-" or "+"
        end
    end
end)

-- REFRESH FUNCTION WITH TOTAL SERVER COUNTING LOGIC
local isRefreshing = false
local refreshCount = 0

local function refresh()
    if isRefreshing then return end
    isRefreshing = true
    RefreshBtn.Text = "⏳"
    ServerCountLabel.Text = "  Filtered: Scanning... | Total: Scanning..."

    -- Clear existing frames
    for _, child in pairs(ScrollingFrame:GetChildren()) do 
        if child:IsA("Frame") or child:IsA("TextLabel") then 
            child:Destroy() 
        end 
    end

    -- Loading Label
    local loadingLabel = Instance.new("TextLabel", ScrollingFrame)
    loadingLabel.Size = UDim2.new(1, 0, 0, 30)
    loadingLabel.BackgroundTransparency = 1
    loadingLabel.Text = "Loading servers..."
    loadingLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    loadingLabel.TextSize = 12

    task.spawn(function()
        refreshCount = refreshCount + 1
        local maxAttempts = 5
        local attempt = 0
        local filteredServers = {}
        local totalServersCount = 0

        while attempt < maxAttempts and #filteredServers == 0 do
            attempt = attempt + 1
            local sortOrder = ((refreshCount + attempt) % 2 == 0) and "Desc" or "Asc"
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=" .. sortOrder .. "&limit=50"

            local ok, res = pcall(function() return game:HttpGet(url) end)

            if ok and res then
                local parseOk, data = pcall(function() return HttpService:JSONDecode(res) end)
                if parseOk and data and data.data then
                    -- Kinukuha ang total count mula sa API response kung available
                    if data.totalCollectionSize then
                        totalServersCount = data.totalCollectionSize
                    else
                        totalServersCount = #data.data
                    end

                    for _, server in pairs(data.data) do
                        if server.playing and server.playing >= 1 and server.playing <= 6 and server.id ~= game.JobId then
                            table.insert(filteredServers, server)
                        end
                    end
                end
            end

            if #filteredServers > 0 then break end
            task.wait(0.5)
        end

        -- Destroy loading label
        if loadingLabel and loadingLabel.Parent then
            loadingLabel:Destroy()
        end

        -- Update Server Counter Display (NILAGYAN NG TOTAL SERVERS)
        local totalText = (totalServersCount > 0) and tostring(totalServersCount) or "50+"
        ServerCountLabel.Text = string.format("  Filtered (1-6P): %d | Total Game Servers: %s", #filteredServers, totalText)

        -- I-display LAHAT ng magagandang nahanap na 1-6 player servers
        if #filteredServers > 0 then
            for _, server in pairs(filteredServers) do
                local sFrame = Instance.new("Frame", ScrollingFrame)
                sFrame.Size = UDim2.new(1, -6, 0, 45)
                sFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)

                local lastJoined = joinHistory[server.id] or "Never"
                
                local info = Instance.new("TextLabel", sFrame)
                info.Size = UDim2.new(0.6, 0, 1, 0)
                info.Text = string.format("Ping: %dms | P: %d/%d\nJoined: %s", server.ping or 0, server.playing or 0, server.maxPlayers or 0, lastJoined)
                info.TextColor3 = Color3.new(0.8, 0.8, 0.8)
                info.TextSize = 10
                info.BackgroundTransparency = 1
                info.TextXAlignment = Enum.TextXAlignment.Left
                info.Position = UDim2.new(0, 5, 0, 0)

                local qBtn = Instance.new("TextButton", sFrame)
                qBtn.Size = UDim2.new(0, 20, 0, 20)
                qBtn.Position = UDim2.new(0.62, 0, 0.25, 0)
                qBtn.Text = "?"
                qBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                qBtn.TextColor3 = Color3.new(1, 1, 1)
                qBtn.TextSize = 10

                local idLabel = Instance.new("TextBox", sFrame)
                idLabel.Size = UDim2.new(0.95, 0, 0, 18)
                idLabel.Position = UDim2.new(0.025, 0, 0.5, -9)
                idLabel.Text = server.id
                idLabel.BackgroundTransparency = 0.1
                idLabel.BackgroundColor3 = Color3.new(0, 0, 0)
                idLabel.TextColor3 = Color3.new(1, 1, 0)
                idLabel.TextSize = 9
                idLabel.Visible = false
                idLabel.ClearTextOnFocus = false
                idLabel.TextEditable = false

                qBtn.MouseButton1Click:Connect(function()
                    idLabel.Visible = not idLabel.Visible
                end)

                local joinBtn = Instance.new("TextButton", sFrame)
                joinBtn.Size = UDim2.new(0.24, 0, 0.6, 0)
                joinBtn.Position = UDim2.new(0.73, 0, 0.2, 0)
                joinBtn.Text = "JOIN"
                joinBtn.TextSize = 11
                joinBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
                joinBtn.TextColor3 = Color3.new(1, 1, 1)

                joinBtn.MouseButton1Click:Connect(function()
                    joinHistory[server.id] = os.date("%x %X")
                    pcall(function() writefile(HISTORY_FILE, HttpService:JSONEncode(joinHistory)) end)
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, Player)
                end)
            end

            task.wait(0.05)
            ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
        else
            local errLabel = Instance.new("TextLabel", ScrollingFrame)
            errLabel.Size = UDim2.new(1, 0, 0, 30)
            errLabel.BackgroundTransparency = 1
            errLabel.Text = "No 1-6 player servers found. Click Refresh again."
            errLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            errLabel.TextSize = 11
        end

        task.wait(0.5)
        RefreshBtn.Text = "↻"
        isRefreshing = false
    end)
end

-- INDEPENDENT AUTO JOIN WITH RETRY LOGIC
local isAutoJoining = false
local function autoJoin()
    if isAutoJoining then return end
    isAutoJoining = true
    AutoJoinBtn.Text = "⏳"

    local maxAttempts = 15
    local attempt = 0
    local teleportSuccess = false

    while attempt < maxAttempts and not teleportSuccess do
        attempt = attempt + 1

        local sortOrder = (attempt % 2 == 0) and "Desc" or "Asc"
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=" .. sortOrder .. "&limit=50"
        
        local ok, res = pcall(function() return game:HttpGet(url) end)

        if ok and res then
            local parseOk, data = pcall(function() return HttpService:JSONDecode(res) end)
            
            if parseOk and data and data.data then
                local validServers = {}

                for _, server in pairs(data.data) do
                    if server.playing and server.playing >= 1 and server.playing <= 6 and server.id ~= game.JobId then
                        table.insert(validServers, server)
                    end
                end

                if #validServers > 0 then
                    local randomServer = validServers[math.random(1, #validServers)]

                    local joinOk, err = pcall(function()
                        joinHistory[randomServer.id] = os.date("%x %X")
                        pcall(function() writefile(HISTORY_FILE, HttpService:JSONEncode(joinHistory)) end)
                        
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServer.id, Player)
                    end)

                    if joinOk then
                        teleportSuccess = true
                        break
                    else
                        warn("Teleport Error: " .. tostring(err) .. " | Retrying attempt #" .. attempt)
                    end
                end
            end
        end

        task.wait(0.5)
    end

    AutoJoinBtn.Text = "🔀"
    isAutoJoining = false
end

AutoJoinBtn.MouseButton1Click:Connect(autoJoin)
RefreshBtn.MouseButton1Click:Connect(refresh)

